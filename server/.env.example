PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/ecogreen

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@yasashviecogreen.com
ADMIN_PASSWORD=change_this_password

# Comma-separated list of origins allowed to call the public endpoints (POST /api/leads, GET /api/blogs*)
CORS_ORIGINS=http://localhost:3000

# Comma-separated list of origins allowed to call the admin-only endpoints (cookie-authenticated)
ADMIN_ORIGINS=http://localhost:4000

# Where the public site lives - leads are redirected here after submission
SITE_URL=http://localhost:3000
