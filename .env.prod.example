# Copy to .env.prod, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Never commit the filled-in .env.prod - it holds real secrets.

# --- Which images to pull ---
REGISTRY=ghcr.io
OWNER=m-afnan2018
NAME=yasashvi-ecogreen
TAG=latest

# --- Backend runtime config ---
# Leave as-is to use the bundled mongo container, or point at a managed
# MongoDB (e.g. Atlas) instead.
MONGODB_URI=mongodb://mongo:27017/ecogreen

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seeded into the database on first `docker compose exec backend node dist/scripts/seedAdmin.js`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Real production domains - no trailing slash. Comma-separate multiple origins.
CORS_ORIGINS=https://yourdomain.com
ADMIN_ORIGINS=https://admin.yourdomain.com
SITE_URL=https://yourdomain.com
